# MetalliSense Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v2
VITE_API_TIMEOUT=30000
VITE_COPILOT_BASE_URL=http://localhost:8001
VITE_VECTORSEARCH_BASE_URL=http://localhost:8002
VITE_API_URL=http://localhost:3000
VITE_MOCK_MODE=false
# Shown by default. Set false in .env.local to hide all voice panels without mounting them.
# Restart Vite after changing this flag. Also supported by npm run dev:mock.
VITE_SHOW_VOICE_PANEL=true
# F2 REST push-to-talk language bridge; also exposed in dev:mock. Off by default.
VITE_LANG_BRIDGE=false
# Read-only two-speaker handover card; supported by dev:mock. Off by default.
VITE_HANDOVER=false
# F11: independent opt-ins. Requires GNANI_TTS_STREAM=on for upstream SSE.
VITE_TTS_STREAM=false
VITE_SPOKEN_NORMALIZE=false
VITE_VOICE_CLARITY=false
# Used only by clarity speech: colloquial default, or formal for F11b wording.
VITE_VOICE_REGISTER=colloquial
