# MetalliSense Agent Service Configuration
PORT=8001
HOST=0.0.0.0

# Copilot Provider Selection (groq, gemini, or claude)
COPILOT_PROVIDER=groq

# Groq (Default STT and LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Google Gemini (Alternative Copilot)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude (Alternative Copilot)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Voice / TTS Configuration (elevenlabs or gtts)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL=eleven_multilingual_v2

# Gnani AI (Prisma STT, Timbre TTS, Evon copilot) — all optional.
# With GNANI_API_KEY empty, Gnani runs in MOCK mode (no network calls, 0 credits).
# STT needs ffmpeg on PATH (Windows: winget install ffmpeg).
# COPILOT_PROVIDER=evon
# STT_PROVIDER=gnani
# TTS_PROVIDER=gnani
# GNANI_API_KEY=your_gnani_api_key_here
# GNANI_BASE_URL=https://api.vachana.ai
# GNANI_MOCK=false
# Default prisma-v3.0. Set GNANI_STT_MODEL= (empty) to omit model and use Prisma v2.5.
# GNANI_STT_MODEL=prisma-v3.0
# v3.0: one locale, up to four comma-separated hints (ta-IN,en-IN), or indic-auto.
# v2.5: one locale only. This example does not change your existing .env language.
# GNANI_STT_LANGUAGE=ta-IN
# Formats: verbatim | transcribe | codemix | transliterate (last two require v3.0).
# GNANI_STT_FORMAT=transcribe
# v3.0 context: up to 200 comma-separated terms. Empty omits keyterms.
# GNANI_STT_KEYTERMS=heat,carbon,silicon,manganese,phosphorus,sulphur,FeSi,FeMn,spectrometer,dashboard,premelt,status,stock,hold
# Optional WebSocket proxy; REST push-to-talk remains available and unchanged.
# Restart the Agent after changing these settings. Requires GNANI_MOCK=false + API key.
GNANI_STREAM_ENABLED=off
GNANI_STREAM_SAMPLE_RATE=16000
# Allowed rates: 8000, 16000, 44100, 48000; client start.sample_rate must match.
# Optional VAD overrides; omit to use provider defaults (0.7 and 500 ms).
# GNANI_STREAM_VAD_THRESHOLD=0.7
# GNANI_STREAM_MIN_SILENCE_MS=500
# /copilot/voice/stream accepts Origin http://localhost:5173 only.
# PCM16-LE mono: 1024-byte frames paced by Agent; stop pads tail and commits.
# Uses GNANI_STT_MODEL=prisma-v3.0 and GNANI_STT_FORMAT/KEYTERMS.
# The streaming deployment may require exactly one locale (observed live).
# Default = first locale of GNANI_STT_LANGUAGE; override the streaming path only:
# GNANI_STREAM_LANGUAGE=ta-IN
# REST keeps its own GNANI_STT_LANGUAGE, including ta-IN,en-IN + codemix.
# 60 s session / 10 s idle limits; documented legacy header aliases are sent too.
# Processing is an empty partial event; current Prisma returns final utterances only.
# On 429, retry once after 1 second; on 504, retry once immediately.
# status().detected_language_code is the last STT result's detected locale (or null).
# GNANI_TTS_MODEL=timbre-v2.5
# GNANI_TTS_VOICE=Kamakshi
# Opt in to v3.0 with GNANI_TTS_MODEL=timbre-v3.0 and GNANI_TTS_VOICE=Shivani
# (or another voice from the v3.0 catalog); the code default stays v2.5.
# Audio tags apply only to style=alert with Timbre v3.0. Off by default.
# GNANI_TTS_TAGS=off
# Never mix model voice catalogs. Keep the existing v2.5 voice as fallback.
# GNANI_TTS_FALLBACK_MODEL=timbre-v2.5
# GNANI_TTS_FALLBACK_VOICE=Kamakshi
# GNANI_TTS_LANGUAGE=ta-IN
# GNANI_TTS_SAMPLE_RATE=22050
# GNANI_TTS_CACHE_DIR=app/data/tts_cache
# Evon v3.3 (OpenAI-compatible endpoint; empty EVON_BASE_URL = mock mode)
# EVON_BASE_URL=http://localhost:8000/v1
# EVON_API_KEY=
# EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
# EVON_MOCK=false
# COPILOT_LANGUAGE=auto
