# MetalliSense Agent Service Configuration
PORT=8001
HOST=0.0.0.0

# Copilot Provider Selection (groq, gemini, or claude)
COPILOT_PROVIDER=groq

# Groq (Default STT and LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Google Gemini (Alternative Copilot)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude (Alternative Copilot)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Voice / TTS Configuration (elevenlabs or gtts)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL=eleven_multilingual_v2
