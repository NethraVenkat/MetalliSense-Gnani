# MetalliSense Agent Service Configuration
PORT=8001
HOST=0.0.0.0

# Copilot Provider Selection (groq, gemini, or claude)
COPILOT_PROVIDER=groq

# Groq (Default STT and LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# Google Gemini (Alternative Copilot)
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Anthropic Claude (Alternative Copilot)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Voice / TTS Configuration (elevenlabs or gtts)
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here
ELEVENLABS_MODEL=eleven_multilingual_v2

# Gnani AI (Prisma STT, Timbre TTS, Evon copilot) — all optional.
# With GNANI_API_KEY empty, Gnani runs in MOCK mode (no network calls, 0 credits).
# STT needs ffmpeg on PATH (Windows: winget install ffmpeg).
# COPILOT_PROVIDER=evon
# STT_PROVIDER=gnani
# TTS_PROVIDER=gnani
# GNANI_API_KEY=your_gnani_api_key_here
# GNANI_BASE_URL=https://api.vachana.ai
# GNANI_MOCK=false
# Default prisma-v3.0. Set GNANI_STT_MODEL= (empty) to omit model and use Prisma v2.5.
# GNANI_STT_MODEL=prisma-v3.0
# v3.0: one locale, up to four comma-separated hints (ta-IN,en-IN), or indic-auto.
# v2.5: one locale only. This example does not change your existing .env language.
# GNANI_STT_LANGUAGE=ta-IN
# Formats: verbatim | transcribe | codemix | transliterate (last two require v3.0).
# GNANI_STT_FORMAT=transcribe
# v3.0 context: up to 200 comma-separated terms. Empty omits keyterms.
# GNANI_STT_KEYTERMS=heat,carbon,silicon,manganese,phosphorus,sulphur,FeSi,FeMn,spectrometer,dashboard,premelt,status,stock,hold
# On 429, retry once after 1 second; on 504, retry once immediately.
# status().detected_language_code is the last STT result's detected locale (or null).
# GNANI_TTS_MODEL=timbre-v2.5
# GNANI_TTS_VOICE=
# GNANI_TTS_LANGUAGE=ta-IN
# GNANI_TTS_SAMPLE_RATE=22050
# GNANI_TTS_CACHE_DIR=app/data/tts_cache
# Evon v3.3 (OpenAI-compatible endpoint; empty EVON_BASE_URL = mock mode)
# EVON_BASE_URL=http://localhost:8000/v1
# EVON_API_KEY=
# EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
# EVON_MOCK=false
# COPILOT_LANGUAGE=auto
